    {
      "parameters": {
        "jsCode": "// Get the receipt data\nconst input = $input.first().json;\nconst token = input.token;\nconst receiptData = input.receiptData;\nconst customerName = input.customerName;\nconst rowId = input.rowId;\n\n// Parse the receiptData if it's a string\nconst receipt = typeof receiptData === 'string' ? JSON.parse(receiptData) : receiptData;\n\n// Calculate total from items\nlet calculatedTotal = 0;\nreceipt.items.forEach(item => {\n  calculatedTotal += item.quantity * item.itemNetPrice;\n});\n\n// Round to 2 decimal places\ncalculatedTotal = Math.round(calculatedTotal * 100) / 100;\nconst expectedTotal = Math.round(receipt.totalAmount * 100) / 100;\n\n// Check if totals match\nconst difference = Math.abs(calculatedTotal - expectedTotal);\n\nif (difference > 0.01) {\n  // Totals don't match - flag as error\n  return [{\n    hasError: true,\n    errorMessage: `Total mismatch: Calculated ${calculatedTotal} ₪ but sheet shows ${expectedTotal} ₪`,\n    customerName: customerName,\n    rowId: rowId\n  }];\n}\n\n// Totals match - continue normally\nreturn [{\n  hasError: false,\n  token: token,\n  receiptData: receipt,\n  customerName: customerName,\n  rowId: rowId,\n  validationStatus: 'OK'\n}];"
      },
