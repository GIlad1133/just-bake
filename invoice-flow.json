    {
      "parameters": {
        "jsCode": "// Check if token exists and is valid\nconst now = new Date().getTime();\nconst tokenData = $vars.keepToken || {};\n\n// Get the original Google Sheets data\nconst sheetsData = $input.first().json;\n\n// STORE sheets data in variables so we can access it later\n$vars.currentSheetsData = sheetsData;\n\n// Check if token exists and hasn't expired\nif (!tokenData.access_token || !tokenData.expires_at || now >= tokenData.expires_at) {\n  return [{ \n    needNewToken: true, \n    sheetsData: sheetsData \n  }];\n} else {\n  return [{ \n    needNewToken: false, \n    token: tokenData.access_token, \n    sheetsData: sheetsData \n  }];\n}"
      },
