    {
      "parameters": {
        "jsCode": "// Get the token and sheets data\nconst token = $input.first().json.token;\nconst data = $input.first().json.sheetsData;\n\n// Convert date string to proper format\nfunction parseDate(dateStr) {\n  if (typeof dateStr === 'string' && dateStr.includes('/')) {\n    const parts = dateStr.split('/');\n    const day = parts[0];\n    const month = parts[1];\n    const year = parts[2].length === 2 ? '20' + parts[2] : parts[2];\n    return `${year}-${month}-${day} 00:00:00`;\n  }\n  \n  if (typeof dateStr === 'number') {\n    const date = new Date((dateStr - 25569) * 86400 * 1000);\n    return date.toISOString().slice(0, 19).replace('T', ' ');\n  }\n  \n  return new Date().toISOString().slice(0, 19).replace('T', ' ');\n}\n\nconst formattedDate = parseDate(data['Date']);\n\n// Build items array - only include items with quantity > 0 AND price > 0\nconst items = [];\n\nconst itemTypes = [\n  { qtyField: 'Neapolitan Kit Qty', priceField: 'Neapolitan Kit Price', name: 'ערכה נפוליטנית' },\n  { qtyField: 'Spelt Kit Qty', priceField: 'Spelt Kit Price', name: 'ערכה כוסמין' },\n  { qtyField: 'Gluten-free Kit Qty', priceField: 'Gluten-free Kit Price', name: 'ערכה ללא גלוטן' },\n  { qtyField: 'Neapolitan Dough Qty', priceField: 'Neapolitan Dough Price', name: 'בצק נפוליטני' },\n  { qtyField: 'Spelt Dough Qty', priceField: 'Spelt Dough Price', name: 'בצק כוסמין' },\n  { qtyField: 'Gluten-free Dough Qty', priceField: 'Gluten-free Dough Price', name: 'בצק ללא גלוטן' },\n  { qtyField: 'White Sauce Qty', priceField: 'White Sauce Price', name: 'רוטב לבן' },\n  { qtyField: 'Red Sauce Qty', priceField: 'Red Sauce Price', name: 'רוטב אדום' },\n  { qtyField: 'Opening Flour Qty', priceField: 'Opening Flour Price', name: 'קמח פתיחה' },\n  { qtyField: 'Cheese Qty', priceField: 'Cheese Price', name: 'גבינה' }\n];\n\nitemTypes.forEach(itemType => {\n  const qty = parseFloat(data[itemType.qtyField]) || 0;\n  const priceInShekels = parseFloat(data[itemType.priceField]) || 0;\n  \n  // Only add if BOTH quantity AND price are greater than 0\n  if (qty > 0 && priceInShekels > 0) {\n    items.push({\n      name: itemType.name,\n      quantity: qty,\n      itemNetPrice: Math.round(priceInShekels * 100), // Convert to agorot\n      itemCurrency: \"ILS\",\n      isNoItemVat: true\n    });\n  }\n});\n\n// Validation: Throw error if no valid items\nif (items.length === 0) {\n  throw new Error(`No valid items for customer ${data['Customer Name']}. Items must have both quantity and price > 0.`);\n}\n\n// Convert total amounts to agorot\nconst totalInShekels = parseFloat(data['Amount (₪)']);\nconst totalInAgorot = Math.round(totalInShekels * 100);\n\n// Build the receipt JSON\nconst receiptData = {\n  type: \"receipt\",\n  client: {\n    name: data['Customer Name'],\n    phone: \"\"\n  },\n  docValueDate: formattedDate,\n  docLang: \"he\",\n  items: items,\n  currency: \"ILS\",\n  originTaxDeduction: 0,\n  totalAmount: totalInAgorot, // In agorot\n  totalPaid: totalInAgorot, // In agorot\n  comment: `תשלום ב${data['payment method'] || 'דיגיטלי'}`,\n  cc: {\n    date: formattedDate,\n    last4Digits: \"0000\",\n    amount: totalInAgorot // In agorot\n  }\n};\n\nreturn [{\n  token: token,\n  receiptData: receiptData,\n  customerName: data['Customer Name'],\n  rowId: data['RowId']\n}];"
      },
