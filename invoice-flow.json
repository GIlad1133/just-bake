      "parameters": {
        "jsCode": "// Get the input\nconst input = $input.first().json;\n\n// Extract from the correct path: payload.url (not body.payload.url)\nconst receiptUrl = input.payload?.url || 'No URL found';\nconst receiptId = input.payload?.id || '';\n\nreturn [{\n  receiptUrl: receiptUrl,\n  receiptId: receiptId,\n  status: 'success'\n}];"
      },
