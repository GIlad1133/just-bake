    {
      "parameters": {
        "jsCode": "// Get all items from the merge\nconst items = $input.all();\n\nlet token = null;\nlet sheetsData = null;\n\n// Find the token and sheetsData from the merged items\nfor (let item of items) {\n  if (item.json.token && !item.json.sheetsData) {\n    token = item.json.token;\n  }\n  if (item.json.sheetsData) {\n    sheetsData = item.json.sheetsData;\n  }\n}\n\n// Combine them into one object\nreturn [{\n  token: token,\n  sheetsData: sheetsData\n}];"
      },
