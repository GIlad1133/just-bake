# Google Sheets Configuration
# Get this from Google Cloud Console - Service Account JSON
# For GitHub Actions, base64 encode the JSON file
GOOGLE_SHEETS_CREDENTIALS={"type": "service_account", "project_id": "your-project-id", ...}

# Google Sheets spreadsheet ID (from URL: docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here

# Keep.co.il API Credentials
# Get these from your Keep.co.il account or existing n8n workflow
KEEP_CLIENT_ID=your-keep-client-id
KEEP_CLIENT_SECRET=your-keep-client-secret

# Keep.co.il API Base URL
KEEP_API_BASE_URL=https://api.keepo.co.il
